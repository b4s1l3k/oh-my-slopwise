{
  "$schema": "../schema/golden-suite.schema.json",
  "schemaVersion": 1,
  "suite": "service-error-security-matrix",
  "description": "Complete public domain-error status/envelope mapping and authentication byte/security edges.",
  "cases": [
    { "id": "error.forbidden", "description": "Authorization failures use 403.", "operation": "error.mapService", "input": { "error": "FORBIDDEN" }, "expected": { "ok": true, "value": { "status": 403, "body": { "error": { "code": "FORBIDDEN", "message": "Недостаточно прав" } } } } },
    { "id": "error.not-found", "description": "Missing resources use 404.", "operation": "error.mapService", "input": { "error": "NOT_FOUND" }, "expected": { "ok": true, "value": { "status": 404, "body": { "error": { "code": "NOT_FOUND", "message": "Не найдено" } } } } },
    { "id": "error.user-not-found", "description": "Missing users use the dedicated 404 code.", "operation": "error.mapService", "input": { "error": "USER_NOT_FOUND" }, "expected": { "ok": true, "value": { "status": 404, "body": { "error": { "code": "USER_NOT_FOUND", "message": "Пользователь не найден" } } } } },
    { "id": "error.payer-not-member", "description": "An invalid payer is a semantic 422.", "operation": "error.mapService", "input": { "error": "PAYER_NOT_MEMBER" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "PAYER_NOT_MEMBER", "message": "Плательщик не состоит в группе" } } } } },
    { "id": "error.split-user-not-member", "description": "An invalid split participant is a semantic 422.", "operation": "error.mapService", "input": { "error": "SPLIT_USER_NOT_MEMBER" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "SPLIT_USER_NOT_MEMBER", "message": "Один из участников не состоит в группе" } } } } },
    { "id": "error.self-settlement", "description": "Self-settlement has a stable 422 envelope.", "operation": "error.mapService", "input": { "error": "SELF_SETTLEMENT" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "SELF_SETTLEMENT", "message": "Нельзя рассчитаться с самим собой" } } } } },
    { "id": "error.recipient-not-member", "description": "Inactive or missing recipients use a stable 422 code.", "operation": "error.mapService", "input": { "error": "RECIPIENT_NOT_MEMBER" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "RECIPIENT_NOT_MEMBER", "message": "Получатель не состоит в группе" } } } } },
    { "id": "error.no-debt", "description": "Settling without debt uses 422.", "operation": "error.mapService", "input": { "error": "NO_DEBT" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "NO_DEBT", "message": "Перед этим участником нет долга" } } } } },
    { "id": "error.amount-exceeds-debt", "description": "Overpayment uses 422.", "operation": "error.mapService", "input": { "error": "AMOUNT_EXCEEDS_DEBT" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "AMOUNT_EXCEEDS_DEBT", "message": "Сумма больше вашего долга" } } } } },
    { "id": "error.group-has-balances", "description": "Deleting an unsettled group conflicts with current state.", "operation": "error.mapService", "input": { "error": "GROUP_HAS_BALANCES" }, "expected": { "ok": true, "value": { "status": 409, "body": { "error": { "code": "GROUP_HAS_BALANCES", "message": "Сначала завершите все расчёты: в группе не должно остаться долгов" } } } } },
    { "id": "error.member-has-balance", "description": "Removing an unsettled member conflicts with current state.", "operation": "error.mapService", "input": { "error": "MEMBER_HAS_BALANCE" }, "expected": { "ok": true, "value": { "status": 409, "body": { "error": { "code": "MEMBER_HAS_BALANCE", "message": "По этому участнику остались долги — сначала завершите расчёты" } } } } },
    { "id": "error.inactive-member-has-balance", "description": "A mutation that recreates inactive debt uses 409.", "operation": "error.mapService", "input": { "error": "INACTIVE_MEMBER_HAS_BALANCE" }, "expected": { "ok": true, "value": { "status": 409, "body": { "error": { "code": "INACTIVE_MEMBER_HAS_BALANCE", "message": "Изменение вернёт долг вышедшему участнику — сначала верните его в группу" } } } } },
    { "id": "error.member-already-active", "description": "Duplicate active membership uses 409.", "operation": "error.mapService", "input": { "error": "MEMBER_ALREADY_ACTIVE" }, "expected": { "ok": true, "value": { "status": 409, "body": { "error": { "code": "MEMBER_ALREADY_ACTIVE", "message": "Пользователь уже состоит в группе" } } } } },
    { "id": "error.admin-cannot-leave", "description": "The admin leave guard uses 409.", "operation": "error.mapService", "input": { "error": "ADMIN_CANNOT_LEAVE" }, "expected": { "ok": true, "value": { "status": 409, "body": { "error": { "code": "ADMIN_CANNOT_LEAVE", "message": "Администратор не может выйти из группы — удалите группу после завершения расчётов" } } } } },
    { "id": "error.cash-payment-invalid", "description": "Invalid cash settlement linkage uses 422.", "operation": "error.mapService", "input": { "error": "CASH_PAYMENT_INVALID" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "CASH_PAYMENT_INVALID", "message": "Наличный платёж должен относиться к участнику и не превышать его долю" } } } } },
    { "id": "error.cash-payments-create-only", "description": "Cash payments on edit use 422.", "operation": "error.mapService", "input": { "error": "CASH_PAYMENTS_CREATE_ONLY" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "CASH_PAYMENTS_CREATE_ONLY", "message": "Наличные можно указать только при создании расхода" } } } } },
    { "id": "error.converted-too-large", "description": "Converted storage overflow uses 422.", "operation": "error.mapService", "input": { "error": "CONVERTED_AMOUNT_TOO_LARGE" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "CONVERTED_AMOUNT_TOO_LARGE", "message": "Сумма после пересчёта слишком велика — проверьте валюту и курс" } } } } },
    { "id": "error.converted-too-small", "description": "A converted zero-minor-unit share uses 422.", "operation": "error.mapService", "input": { "error": "CONVERTED_AMOUNT_TOO_SMALL" }, "expected": { "ok": true, "value": { "status": 422, "body": { "error": { "code": "CONVERTED_AMOUNT_TOO_SMALL", "message": "Сумма после пересчёта меньше минимальной единицы валюты группы" } } } } },
    { "id": "error.invite-invalid", "description": "Invalid and revoked invites share a non-enumerable 404 response.", "operation": "error.mapService", "input": { "error": "INVITE_INVALID" }, "expected": { "ok": true, "value": { "status": 404, "body": { "error": { "code": "INVITE_INVALID", "message": "Приглашение недействительно или отозвано" } } } } },
    { "id": "security.non-error-object-is-generic", "description": "Arbitrary thrown objects do not leak fields or stack-like content.", "operation": "error.mapService", "input": { "error": { "message": "FORBIDDEN", "password": "secret", "stack": "internal" } }, "expected": { "ok": true, "value": { "status": 500, "body": { "error": { "message": "Внутренняя ошибка" } } } } },
    { "id": "security.password-73-ascii-bytes", "description": "One byte above bcrypt's limit is rejected.", "operation": "auth.passwordWithinBcryptLimit", "input": { "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expected": { "ok": true, "value": { "accepted": false } } },
    { "id": "security.password-72-cyrillic-bytes", "description": "Thirty-six two-byte Cyrillic code points fit exactly.", "operation": "auth.passwordWithinBcryptLimit", "input": { "password": "яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя" }, "expected": { "ok": true, "value": { "accepted": true } } },
    { "id": "security.password-72-emoji-bytes", "description": "Eighteen four-byte emoji code points fit exactly.", "operation": "auth.passwordWithinBcryptLimit", "input": { "password": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀" }, "expected": { "ok": true, "value": { "accepted": true } } },
    { "id": "security.password-76-emoji-bytes", "description": "Nineteen four-byte emoji code points exceed bcrypt's limit.", "operation": "auth.passwordWithinBcryptLimit", "input": { "password": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀" }, "expected": { "ok": true, "value": { "accepted": false } } },
    { "id": "security.session-update-empty-name-ignored", "description": "An empty session update cannot erase the authenticated token name.", "operation": "auth.projectSession", "input": { "token": { "id": "u1", "name": "Alice", "role": "USER" }, "trigger": "update", "sessionUpdate": { "name": "" }, "sessionUser": { "id": "u1", "name": "Alice", "role": "USER" } }, "expected": { "ok": true, "value": { "token": { "id": "u1", "name": "Alice", "role": "USER" }, "session": { "user": { "id": "u1", "name": "Alice", "role": "USER" } } } } }
  ]
}
