      "operation": "statistics.buildProfile",
      "input": {
        "metrics": {
          "accountAgeDays": 400,
          "profileReady": 1,
          "activeGroups": 5,
          "groupsCreated": 2,
          "invitesCreated": 3,
          "expensesCreated": 10,
