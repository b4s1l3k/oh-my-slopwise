{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopwise.local/contracts/golden/golden-suite.schema.json",
  "title": "SLOPwise golden compatibility suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "suite", "description", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "operation", "input", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "description": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "pattern": "^[a-z]+(?:[A-Za-z]+)?\\.[a-zA-Z]+$" },
        "input": {},
        "expected": { "$ref": "#/$defs/outcome" },
        "expectedByAdapter": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "legacy": { "$ref": "#/$defs/outcome" },
            "candidate": { "$ref": "#/$defs/outcome" }
          }
        }
      }
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "value"],
          "properties": {
            "ok": { "const": true },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "error"],
          "properties": {
            "ok": { "const": false },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  }
}
