          "groupTypesUsed": 4,
          "homeGroups": 1,
          "tripGroups": 2,
          "coupleGroups": 1,
          "maxGroupMembers": 6,
          "maxGroupExpenses": 10
        },
        "money": {
          "spent": [
            { "currency": "RUB", "amount": 5000 },
            { "currency": "USD", "amount": 1000 }
          ],
          "returned": [{ "currency": "RUB", "amount": 200 }]
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "money": {
            "spent": [
              { "currency": "RUB", "amount": 5000 },
              { "currency": "USD", "amount": 1000 }
            ],
            "returned": [{ "currency": "RUB", "amount": 200 }]
