datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique @db.Citext
  name         String
  avatarUrl    String?
  passwordHash String

  // Дефолтные реквизиты для получения переводов
  payeeName    String? // ФИО получателя
  bankName     String? // банк
  payeeAccount String? // номер карты / телефона

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  groupsCreated       Group[]                 @relation("GroupCreator")
  groupMemberships    GroupMember[]
  expensesPaid        Expense[]               @relation("ExpensePayer")
  expensesCreated     Expense[]               @relation("ExpenseCreator")
  expenseSplits       ExpenseSplit[]
  settlementsFrom     Settlement[]            @relation("SettlementFrom")
  settlementsTo       Settlement[]            @relation("SettlementTo")
  activities          ActivityLog[]
  invitesCreated      GroupInvite[]           @relation("InviteCreator")
  feedbacks           Feedback[]
  achievements        UserAchievement[]
  statisticFacts      UserStatisticFact[]
  statisticMetrics    UserStatisticMetric[]
  statisticCurrencies UserStatisticCurrency[]
  statisticMoney      UserStatisticMoney[]
  groupPositions      GroupMemberPosition[]
  idempotencyRecords  IdempotencyRecord[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users")
}

// Полученные ачивки хранятся отдельно от текущих статистических метрик.
// Поэтому уже открытая награда не пропадает после удаления исходных данных.
model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now()) @db.Timestamptz(3)
  // Момент, когда пользователю показали всплывающее уведомление об ачивке.
  // null — ещё не показывали (нужно всплыть). Существующие записи при миграции
  // помечаются как уже показанные, чтобы не спамить прошлыми наградами.
  notifiedAt    DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, notifiedAt])
  @@map("user_achievements")
}

// Immutable account-level facts survive deletion of their source groups,
// expenses and settlements. They power lifetime statistics and achievements,
// while the existing domain tables remain the source of current statistics.
model UserStatisticFact {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  reference String
  value     Int      @default(1)
  currency  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, reference])
  @@index([reference, kind])
  @@map("user_statistic_facts")
}

// Compact, transactionally maintained read models. PostgreSQL triggers keep
// them in sync with UserStatisticFact; facts remain the rebuildable history.
model UserStatisticMetric {
  userId    String
  kind      String
  factCount BigInt
  maxValue  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("user_statistic_metrics")
}

model UserStatisticCurrency {
  userId    String
  currency  String
  factCount BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, currency])
  @@map("user_statistic_currencies")
}

model UserStatisticMoney {
  userId     String
  kind       String
  currency   String
  totalValue BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, currency])
  @@map("user_statistic_money")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("feedbacks")
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType @default(OTHER)
  currency    String    @default("RUB")
  createdById String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  createdBy   User                  @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  activities  ActivityLog[]
  invites     GroupInvite[]
  positions   GroupMemberPosition[]

  @@index([createdById])
  @@map("groups")
}

enum GroupType {
  HOME
  TRIP
  COUPLE
  OTHER
}

model GroupMember {
  id             String          @id @default(cuid())
  groupId        String
  userId         String
  role           GroupMemberRole @default(MEMBER)
  joinedAt       DateTime        @default(now()) @db.Timestamptz(3)
  isActive       Boolean         @default(true)
  groupUpdatedAt DateTime        @default(now()) @db.Timestamptz(3)

  // Переопределение реквизитов для этой поездки (если null — берутся из профиля)
  payeeName    String?
  bankName     String?
  payeeAccount String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId, isActive, groupUpdatedAt(sort: Desc), groupId(sort: Desc)])
  @@map("group_members")
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

model Expense {
  id          String    @id @default(cuid())
  groupId     String
  paidById    String
  createdById String
  title       String
  amount      Int
  currency    String    @default("RUB")
  amountBase  Int // сумма в валюте расчёта группы (по курсу на дату операции)
  customRate  Decimal?  @db.Decimal(20, 10) // ручной курс «валюта траты → валюта расчёта»; null = курс ЦБ
  category    String?
  splitType   SplitType @default(EQUAL)
  date        DateTime  @db.Date
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User           @relation("ExpensePayer", fields: [paidById], references: [id])
  createdBy   User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  splits      ExpenseSplit[]
  // Расчёты наличными, сделанные в момент этой траты
  settlements Settlement[]

  @@index([groupId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([paidById])
  @@index([createdById])
  @@map("expenses")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

enum IdempotencyOperation {
  CREATE_GROUP
  CREATE_EXPENSE
  CREATE_SETTLEMENT
  CREATE_FEEDBACK
}

// Deduplicates retried create commands. The record is committed atomically
// with the created resource; expired records are pruned on the principal's
// next idempotent command and are also suitable for a scheduled cleanup job.
model IdempotencyRecord {
  id          String               @id @default(cuid())
  principalId String
  operation   IdempotencyOperation
  key         String               @db.VarChar(128)
  requestHash String               @db.Char(64)
  resourceId  String
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime             @db.Timestamptz(3)

  principal User @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@unique([principalId, operation, key])
  @@index([principalId, expiresAt])
  @@map("idempotency_records")
}

model ExpenseSplit {
  id         String @id @default(cuid())
  expenseId  String
  userId     String
  amount     Int
  amountBase Int // доля в валюте расчёта группы
  percentage Int?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

model Settlement {
  id         String   @id @default(cuid())
  groupId    String
  expenseId  String? // если расчёт сделан наличными в момент конкретной траты
  fromUserId String
  toUserId   String
  amount     Int
  currency   String   @default("RUB")
  amountBase Int // сумма в валюте расчёта группы
  date       DateTime @db.Date
  notes      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expense  Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fromUser User     @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User     @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([groupId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([expenseId])
  @@index([fromUserId, toUserId])
  @@index([toUserId])
  @@map("settlements")
}

model ActivityLog {
  id         String       @id @default(cuid())
  groupId    String
  actorId    String
  type       ActivityType
  entityType String
  entityId   String
  metadata   Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([groupId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@map("activity_log")
}

enum ActivityType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  SETTLEMENTS_RESET
  MEMBER_ADDED
  MEMBER_REMOVED
  GROUP_UPDATED
}

// Ссылка-приглашение в поездку (многоразовая, можно отозвать)
model GroupInvite {
  id          String   @id @default(cuid())
  token       String   @unique
  groupId     String
  createdById String
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([groupId])
  @@index([createdById])
  @@map("group_invites")
}

// Кэш курсов ЦБ РФ: сколько рублей за 1 единицу валюты на дату
model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  currency  String
  rate      Decimal  @db.Decimal(20, 10)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([date, currency])
  @@index([currency, date(sort: Desc)])
  @@map("exchange_rates")
}

// Current net position in the group's settlement currency. Database triggers
// maintain it from expenses, splits and settlements in the same transaction.
model GroupMemberPosition {
  groupId   String
  userId    String
  balance   BigInt   @default(0)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
  @@index([userId, groupId])
  @@map("group_member_positions")
}
