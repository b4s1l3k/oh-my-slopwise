            "expensesParticipated": 11,
            "expensesCreated": 10,
            "expensesPaid": 7,
            "activeGroups": 5
          },
          "splits": { "equal": 5, "exact": 3, "percentage": 2 },
          "collaboration": {
            "uniquePeople": 4,
            "settlementsSent": 3,
            "settlementsReceived": 2,
            "cashSettlements": 1,
            "invitesCreated": 3,
            "createdForOthers": 2
          },
          "groups": { "created": 2, "home": 1, "trip": 2, "couple": 1, "other": 1 },
          "mastery": { "currenciesUsed": 4, "splitMethodsUsed": 3, "customRates": 1 },
          "records": {
            "maxExpenseParticipants": 6,
            "maxPaidParticipants": 5,
            "maxGroupMembers": 6,
            "maxGroupExpenses": 10,
            "accountAgeDays": 400
          }
