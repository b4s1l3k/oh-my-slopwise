{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopwise.local/contracts/golden/golden-manifest.schema.json",
  "title": "SLOPwise golden suite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "suites"],
  "properties": {
    "$schema": { "const": "schema/golden-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fixtures/[a-z0-9][a-z0-9._-]*\\.json$"
      }
    }
  }
}
