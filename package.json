{
  "name": "SLOPwise-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:rebuild-projections": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/rebuild-projections.ts",
    "db:rebuild-projections:test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/rebuild-projections.ts --test",
    "typecheck": "tsc --noEmit",
    "contract:generate": "node --import tsx scripts/contracts/generate-typescript.ts",
    "contract:check": "node --import tsx scripts/contracts/generate-typescript.ts --check",
    "test": "vitest run",
    "test:contract": "npm run contract:check && vitest run contracts/openapi/*.test.ts src/app/api/v1/api-routes.contract.test.ts",
    "test:golden": "vitest run contracts/golden/golden.test.ts && node --import tsx scripts/golden/run.ts legacy",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_SERVER_MODE=production playwright test",
    "test:e2e:candidate": "E2E_EXTERNAL_SERVER=true playwright test",
    "test:migration:candidate": "node --import tsx scripts/migration/run-candidate-gate.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx ./scripts/run-db-tests.ts",
    "test:coverage": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx ./scripts/run-db-tests.ts --coverage",
    "test:quality": "npm run contract:check && npm run typecheck && npm test && npm run test:golden && npm run build",
    "test:regression": "npm run test:quality && npm run test:db && npm run test:e2e:production",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "setup": "npm ci && npm run db:generate && npm run db:deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.56.0",
    "@tanstack/react-query-devtools": "^5.56.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.4.47",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
